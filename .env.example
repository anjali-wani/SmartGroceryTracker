# Database Configuration
# Default is SQLite for fast local development, or set your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/grocery_tracker
DATABASE_URL=sqlite:///./grocery_tracker.db

# Entity Resolution
RAPIDFUZZ_THRESHOLD=85.0

# Optional: Gemini API Key for Tier-3 LLM classification fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
